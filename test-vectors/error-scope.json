      "error": "RESOURCE_LIMIT",
      "expected_scope": "carrier",
      "expected_action": "CARRIER_CLOSE"
    },
    {
      "name": "session-resource-limit",
      "context": "ESTABLISHED_SESSION",
      "resource_scope": "shared_session_state",
      "error": "RESOURCE_LIMIT",
      "expected_scope": "session",
      "expected_action": "SESSION_CLOSE"
    },
    {
      "name": "session-error-atomicity",
      "context": "SESSION_CLOSING",
      "other_carrier_frame": "STREAM_OPEN",
      "expected": "must_not_create_new_stream"
    },
    {
      "name": "no-specific-trigger-frame",
      "context": "local_session_failure",
      "error": "INTERNAL_ERROR",
